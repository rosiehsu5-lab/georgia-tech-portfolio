--- !u!114 &1876994364
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1876994361}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5294dd2af89c1471c8bc13d00eb83a3f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  slides:
  - text: Q1 targets are slipping. Leadership is escalating.
    backgroundTint: {r: 0.05, g: 0.08, b: 0.12, a: 1}
    oneShotOnShow: {fileID: 0}
  - text: You are Pengu, formerly part of a larger delivery team. Due to recent "organisational
      restructuring," you are now the entire team.
    backgroundTint: {r: 0.02, g: 0.02, b: 0.05, a: 1}
    oneShotOnShow: {fileID: 0}
  - text: Deliver as many fish as you can to the log house before time runs out.
    backgroundTint: {r: 0.05, g: 0.1, b: 0.15, a: 1}
    oneShotOnShow: {fileID: 0}
  - text: Seals are on patrol. If they see or hear you, they will chase and catch
      you. The faster you go, the louder you are... and the easier you are to find.
    backgroundTint: {r: 0.12, g: 0.04, b: 0.04, a: 1}
    oneShotOnShow: {fileID: 0}
  - text: No pressure. We'll be monitoring your performance in real time... and adjusting
      headcount as needed.
    backgroundTint: {r: 0.2, g: 0.02, b: 0.02, a: 1}
    oneShotOnShow: {fileID: 0}
